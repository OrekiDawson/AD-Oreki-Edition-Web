console.log("\n### C. 鍊嶇巼涓€斿垏鎹細鍘嗗彶绱閲忎笉寰楄鏂板€嶇巼閲嶇畻");
const segC = await page.evaluate(() => {
  const P = window.__probe;
  const c0 = P.read();
  GameSpeed.set(1);      gameLoop(100);
  GameSpeed.set(10000);  gameLoop(100);
  GameSpeed.set(1);      gameLoop(100);
  const c1 = P.read();
  const d = P.delta(c0, c1);
  return {
    d,
    // 鏃у啓娉曪紙鐢ㄥ綋鍓嶅€嶇巼鍙嶆帹鏁存鍘嗗彶锛変細寰楀埌鐨勫€?    legacy: (c1.raw - c0.raw) / getGlobalSpeedFactor(),
    factorNow: getGlobalSpeedFactor(),
  };
});
check("[C] 鐜板疄涓‘瀹炵粡鍘嗕簡 300ms", near(segC.d.real, 300, 1e-6), String(segC.d.real));
check("[C] 鍘熷娓告垙鏃堕棿 = 1脳100 + 10000脳100 + 1脳100 = 1,000,200ms",
  near(segC.d.raw, 1000200, 10), String(segC.d.raw));
check("[C] 鎸夋椂闂寸墖绱鐨勬父鎴忓唴鏃堕棿 = 300ms锛堜笉鍙楁湯娆″€嶇巼褰卞搷锛?, near(segC.d.inGame, 300, 1), String(segC.d.inGame));
check("[C] 鏃у啓娉曘€屽師濮嬫父鎴忔椂闂?/ 褰撳墠鍊嶇巼銆嶄細寰楀埌 1,000,200ms锛堥敊璇斁澶?3334 鍊嶏級",
  near(segC.legacy, 1000200, 10) && !near(segC.legacy, segC.d.inGame, 10),
  `legacy=${segC.legacy} tracked=${segC.d.inGame}`);

