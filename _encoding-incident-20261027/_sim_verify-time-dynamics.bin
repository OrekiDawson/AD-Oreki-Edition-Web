// 鏃堕棿璇箟锛氬姩鎬佸€嶇巼銆佺壒娈婇樁娈点€佺绾跨粨绠楃殑娴忚鍣ㄥ洖褰?// 鐢ㄦ硶: node verify-time-dynamics.mjs [root] [port]
import http from "node:http";
import fs from "node:fs";
import path from "node:path";

const EDGE = "C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe";
const root = path.resolve(process.argv[2] || "C:/Users/Oreki/WorkBuddy/AD-Oreki-Unified/web/AD-Oreki-Edition");
const port = Number(process.argv[3] || 8095);

const MIME = {
  ".html": "text/html; charset=utf-8", ".js": "text/javascript; charset=utf-8",
  ".css": "text/css; charset=utf-8", ".json": "application/json; charset=utf-8",
  ".png": "image/png", ".svg": "image/svg+xml", ".webm": "video/webm", ".mp3": "audio/mpeg",
  ".woff": "font/woff", ".woff2": "font/woff2", ".ttf": "font/ttf", ".otf": "font/otf",
  ".eot": "application/vnd.ms-fontobject", ".ico": "image/x-icon",
};
const server = http.createServer((req, res) => {
  let p = decodeURIComponent(req.url.split("?")[0]);
  if (p.endsWith("/")) p += "index.html";
  const file = path.join(root, p);
  if (!file.startsWith(root)) { res.writeHead(403).end(); return; }
  fs.readFile(file, (err, data) => {
    if (err) { res.writeHead(404).end("nf"); return; }
    res.writeHead(200, { "Content-Type": MIME[path.extname(file).toLowerCase()] || "application/octet-stream" });
    res.end(data);
  });
});
await new Promise(r => server.listen(port, "127.0.0.1", r));

const SAVE_DIR = "C:/Users/Oreki/WorkBuddy/AD-Oreki-Unified/web/_saves/samples";
const samples = fs.readdirSync(SAVE_DIR).filter(f => f.endsWith(".txt"));
const pickSave = name => {
  const f = samples.find(x => x.startsWith(name + ".")) || samples.find(x => x.startsWith(name));
  return f ? fs.readFileSync(path.join(SAVE_DIR, f), "utf-8") : null;
};

const puppeteer = (await import("puppeteer-core")).default;
const browser = await puppeteer.launch({
  executablePath: EDGE, headless: "new",
  args: ["--no-sandbox", "--disable-gpu", "--mute-audio", "--autoplay-policy=no-user-gesture-required"],
});
const results = [];
const skips = [];
const check = (n, p, d = "") => { results.push({ n, p, d }); console.log(`${p ? "PASS" : "FAIL"}  ${n}${d ? "  鈥?" + d : ""}`); };
const skip = (n, why) => { skips.push({ n, why }); console.log(`SKIP  ${n}  鈥?${why}`); };
const near = (a, b, eps) => Math.abs(a - b) <= eps;

const page = await browser.newPage();
const errs = [];
page.on("pageerror", e => errs.push(e.message));
await page.setViewport({ width: 1400, height: 950 });
await page.goto(`http://127.0.0.1:${port}/index.html`, { waitUntil: "load", timeout: 60000 });
await new Promise(r => setTimeout(r, 6500));
const sleep = ms => new Promise(r => setTimeout(r, ms));

// 缁熶竴鐨勩€岃-璁℃椂-璇汇€嶆帰閽堬紝娉ㄥ叆鍒伴〉闈㈤噷澶嶇敤
await page.evaluate(() => {
  window.__probe = {
    read() {
      const r = player.records;
      return {
        real: r.realTimePlayed,
        raw: r.totalTimePlayed,
        inGame: r.totalInGameTime,
        iTime: r.thisInfinity.time,
        iReal: r.thisInfinity.realTime,
        iInGame: r.thisInfinity.inGameTime,
        eTime: r.thisEternity.time,
        eInGame: r.thisEternity.inGameTime,
      };
    },
    delta(a, b) {
      const out = {};
      for (const k of Object.keys(a)) out[k] = b[k] - a[k];
      return out;
    },
  };
});

// =====================================================================
console.log("\n### A. 鍒嗘鑶ㄨ儉锛氫笁娈典笉鍚屽€嶇巼鍚?100ms 澧欓挓");
const segA = await page.evaluate(() => {
  try { GameIntervals.gameLoop.stop(); } catch { /* 鏈惎鍔?*/ }
  GameSpeed.set(1);
  player.options.gamePaused = false;
  player.challenge.eternity.current = 0;
  player.celestials.enslaved.isStoringReal = false;
  player.lastUpdate = Date.now();
  const P = window.__probe;
  const a0 = P.read();
  gameLoop(100, { blackHoleSpeedup: 100 });   // 鑶ㄨ儉 100脳
  const a1 = P.read();
  gameLoop(100);                              // 鏃犺啫鑳€
  const a2 = P.read();
  gameLoop(100, { blackHoleSpeedup: 50 });    // 鑶ㄨ儉 50脳
  const a3 = P.read();
  return { s1: P.delta(a0, a1), s2: P.delta(a1, a2), s3: P.delta(a2, a3), a0, a3 };
});
check("[A] 娈?1锛堣啫鑳€ 100脳锛夛細娓告垙鏃堕棿 +10,000ms", near(segA.s1.iTime, 10000, 1), String(segA.s1.iTime));
check("[A] 娈?1锛堣啫鑳€ 100脳锛夛細鐜板疄鏃堕棿 +100ms", near(segA.s1.iReal, 100, 1e-6), String(segA.s1.iReal));
check("[A] 娈?2锛堟棤鑶ㄨ儉锛夛細娓告垙鏃堕棿 +100ms", near(segA.s2.iTime, 100, 1e-6), String(segA.s2.iTime));
check("[A] 娈?3锛堣啫鑳€ 50脳锛夛細娓告垙鏃堕棿 +5,000ms", near(segA.s3.iTime, 5000, 1), String(segA.s3.iTime));
const sumA = ["s1", "s2", "s3"].reduce((acc, k) => acc + segA[k].inGame, 0);
check("[A] 涓夋鐜板疄鏃堕棿鍚堣 300ms", near(sumA, 300, 1e-6), String(sumA));
const gameA = segA.s1.iTime + segA.s2.iTime + segA.s3.iTime;
check("[A] 涓夋娓告垙鏃堕棿鍚堣 15,100ms锛堟寜娈靛姞鏉冿紝鑰岄潪鏈鍊嶇巼 脳 鎬绘椂闀匡級", near(gameA, 15100, 2), String(gameA));
check("[A] 鑻ヨ鐢ㄦ湯娈靛€嶇巼 50脳 浼氬緱鍒?15,000 鑰岄潪 15,100",
  !near(300 * 50, gameA, 1), `300脳50=${300 * 50} vs ${gameA}`);
const inGameA = segA.s1.inGame + segA.s2.inGame + segA.s3.inGame;
check("[A] 鎸夋椂闂寸墖绱鐨勬父鎴忓唴鏃堕棿 = 鐜板疄鏃堕棿锛堝€嶇巼 1脳 鏃朵袱鑰呯浉绛夛級", near(inGameA, sumA, 1), String(inGameA));

// =====================================================================
console.log("\n### B. 鍚屼竴鍒嗘搴忓垪鍦?10000脳 涓嬶紝娓告垙鍐呮椂闂村繀椤讳笉鍙?);
const segB = await page.evaluate(() => {
  GameSpeed.set(10000);
  player.lastUpdate = Date.now();
  const P = window.__probe;
  const b0 = P.read();
  gameLoop(100, { blackHoleSpeedup: 100 });
  const b1 = P.read();
  gameLoop(100);
  const b2 = P.read();
  gameLoop(100, { blackHoleSpeedup: 50 });
  const b3 = P.read();
  return { s1: P.delta(b0, b1), s2: P.delta(b1, b2), s3: P.delta(b2, b3) };
});
check("[B] 10000脳 涓嬫 1 鍘熷娓告垙鏃堕棿 = 1e8ms锛?0,000脳 鏀惧ぇ锛?, near(segB.s1.iTime, 1e8, 100), String(segB.s1.iTime));
check("[B] 10000脳 涓嬫 1 鐜板疄鏃堕棿浠嶄负 100ms", near(segB.s1.iReal, 100, 1e-6), String(segB.s1.iReal));
const inGameB = segB.s1.inGame + segB.s2.inGame + segB.s3.inGame;
check("[B] 10000脳 涓嬫父鎴忓唴鏃堕棿澧為噺涓?1脳 瀹屽叏涓€鑷达紙300ms锛?, near(inGameB, 300, 1), `${inGameB} vs ${inGameA}`);
check("[B] 10000脳 涓嬪師濮嬫父鎴忔椂闂存槸 1脳 鐨?10000 鍊?,
  near((segB.s1.iTime + segB.s2.iTime + segB.s3.iTime) / gameA, 10000, 0.01),
  String((segB.s1.iTime + segB.s2.iTime + segB.s3.iTime) / gameA));

